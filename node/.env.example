# ==============================================================================
# ISP Chat - Variaveis de Ambiente do No do Provedor (Partner ISP Node)
# Copie este arquivo para .env: cp .env.example .env
# ==============================================================================

# Identificador unico do No na malha Kademlia DHT (UUIDv7 RFC 9562)
ISPCHAT_DHT_NODE_ID=01950000-0000-7000-8000-000000000001

# Endereco publico anunciado pelo No ISP na porta 443 (deve coincidir com o SAN X.509)
ISPCHAT_NODE_PUBLIC_ADDRESS=node1.ispchat.dev.br:443

# Chave publica Ed25519 Nivel 0 da Governanca Raiz (64 hex chars ou Base64URL de 32 bytes)
ISPCHAT_ROOT_PUBLIC_KEY=

# Endereco mTLS do servidor Principal (Governanca & Fallback Home Node)
ISPCHAT_PRINCIPAL_ADDRESS=principal.ispchat.dev.br:443

# Dominio DNS SRV de descoberta automatica da malha
ISPCHAT_SRV_DOMAIN=_ispchat._tcp.ispchat.dev.br

# Dominio / Realm do provedor parceiro para o Coturn
ISP_DOMAIN=ispchat.dev.br

# Endereco IPv4 publico da VPS do No (usado pelo Coturn para anunciar candidatos ICE)
ISP_EXTERNAL_IP=203.0.113.10

# Segredo criptografico compartilhado com o Coturn (gere com: openssl rand -hex 32)
TURN_STATIC_AUTH_SECRET=substitua_por_openssl_rand_hex_32
