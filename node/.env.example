# ==============================================================================
# ISP Chat - Variaveis de Ambiente do No do Provedor (ISP Node)
# Copie este arquivo para .env: cp .env.example .env
# ==============================================================================

# Identificador unico do No na malha Kademlia DHT (UUIDv7 ou FQDN do provedor)
ISPCHAT_NODE_ID=node1.ispchat.dev.br

# Dominio / Realm do provedor parceiro
ISP_DOMAIN=ispchat.dev.br

# Endereco IPv4 publico da VPS do No (usado pelo Coturn para anunciar candidatos ICE)
ISP_EXTERNAL_IP=203.0.113.10

# Segredo criptografico do TURN (gere com: openssl rand -hex 32)
TURN_STATIC_AUTH_SECRET=substitua_por_openssl_rand_hex_32
