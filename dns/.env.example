# Variáveis de ambiente para o PowerDNS Auth e PowerDNS-Admin
# Copie este arquivo para ".env" e preencha com suas senhas reais ANTES de subir o docker-compose.

# Usuário e senha do banco PostgreSQL
# Para gerar uma senha forte para o banco, você pode usar no terminal:
# openssl rand -hex 24
PDNS_DB_USER=pdns_user
PDNS_DB_PASSWORD=uma_senha_muito_forte_aqui

# Chave da API REST do PowerDNS (usado pelo painel e para integrações)
# Esta chave precisa ser longa e segura. Para gerar uma boa chave, use:
# openssl rand -hex 32
PDNS_API_KEY=uma_chave_aleatoria_longa_aqui

# Secret Key usada pelo painel PowerDNS-Admin (Flask) para criptografar as sessões e cookies.
# É recomendado que seja uma string base64 ou hex bem longa. Exemplo para gerar:
# openssl rand -base64 32
PDNS_ADMIN_SECRET_KEY=outra_chave_aleatoria_longa_aqui
