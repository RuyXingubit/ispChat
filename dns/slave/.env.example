# Variáveis de ambiente para o PowerDNS Slave (VPS 2 e VPS 3)
# Copie este arquivo para ".env" e preencha com senhas seguras.
# Nota: Estas senhas são apenas para o banco LOCAL do slave, não precisam ser iguais as do Master.

# Usuário e senha do banco PostgreSQL Local (Slave)
# openssl rand -hex 24
PDNS_DB_USER=pdns_user
PDNS_DB_PASSWORD=uma_senha_muito_forte_aqui
