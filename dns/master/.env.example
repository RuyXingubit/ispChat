# Variáveis de ambiente para o PowerDNS Master e PowerDNS-Admin
# Copie este arquivo para ".env" e preencha com suas senhas reais ANTES de subir o docker-compose.

# Usuário e senha do banco PostgreSQL (Master)
# Para gerar uma senha forte para o banco, você pode usar no terminal:
# openssl rand -hex 24
PDNS_DB_USER=pdns_user
PDNS_DB_PASSWORD=uma_senha_muito_forte_aqui

# Chave da API REST do PowerDNS (usada pelo painel e para integrações)
# openssl rand -hex 32
PDNS_API_KEY=uma_chave_aleatoria_longa_aqui

# Secret Key usada pelo painel PowerDNS-Admin (Flask)
# openssl rand -base64 32
PDNS_ADMIN_SECRET_KEY=outra_chave_aleatoria_longa_aqui

# IP(s) dos Slaves que têm permissão para baixar as zonas via AXFR (separados por vírgula)
# Exemplo: 1.2.3.4,5.6.7.8
SLAVE_IPS=0.0.0.0/0
